# For a manually created backend/.env, set a unique value of at least 16 characters.
# scripts/dev.sh creates backend/.env with a random password if the file is absent.
TOUCHVIZ_ADMIN_PASSWORD=

# Local development uses HTTP. Set true when the Admin UI is served over HTTPS.
TOUCHVIZ_ADMIN_COOKIE_SECURE=false

# Maximum combined size of the HDR and IMG upload, in bytes (8 GiB by default).
TOUCHVIZ_MAX_UPLOAD_BYTES=8589934592

# Comma-separated origins for an externally hosted Admin UI, if needed.
# Example: TOUCHVIZ_ADMIN_ORIGINS=https://admin.example.org
TOUCHVIZ_ADMIN_ORIGINS=
